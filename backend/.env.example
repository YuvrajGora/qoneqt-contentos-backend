# Application
APP_ENV=development
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Content Planning (Google Gemini)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Visual Generation (Hugging Face / FLUX)
HF_TOKEN=

# Text-to-Speech (ElevenLabs - optional, edge-tts is used as fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Content Planning Fallback (Groq - optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloud Storage (AWS S3 / R2 / Supabase - optional, local /assets used as fallback)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
